<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name=".debug.WidgetPreviewActivity"
            android:exported="true"
            android:label="Widget preview"
            android:theme="@style/Theme.Readout" />

        <!-- Debug only: lets `adb shell am start-foreground-service` drive the service for
             verification without touching the device UI. Never present in release builds. -->
        <service
            android:name=".notification.PrintNotificationService"
            android:exported="true"
            tools:replace="android:exported" />
    </application>
</manifest>
