<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/camera_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_camera_description"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/camera_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/widget_band_idle"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingTop="30dp"
        android:paddingEnd="12dp"
        android:paddingBottom="26dp"
        android:text="@string/widget_camera_empty"
        android:textColor="@color/widget_ink"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/camera_band"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="@color/widget_plate"
        android:fontFamily="monospace"
        android:letterSpacing="0.12"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="@string/widget_state_placeholder"
        android:textColor="@color/widget_on_plate"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/camera_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/widget_caption_scrim"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="@string/widget_job_placeholder"
        android:textColor="@color/widget_ink"
        android:textSize="11sp" />
</FrameLayout>
