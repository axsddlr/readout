<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_band"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/widget_band_idle"
        android:fontFamily="monospace"
        android:letterSpacing="0.12"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="@string/widget_state_placeholder"
        android:textColor="@color/widget_ink"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:text="@string/widget_nozzle"
        android:textColor="@color/widget_muted"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_nozzle_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/widget_temperature_placeholder"
        android:textColor="@color/widget_ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:text="@string/widget_bed"
        android:textColor="@color/widget_muted"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_bed_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/widget_temperature_placeholder"
        android:textColor="@color/widget_ink"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
